# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# API server
CORS_ORIGINS=http://localhost:8000

# Optional: require this header on POST /api/ingest/telemetry
INGEST_API_KEY=replace-with-a-long-random-secret

# --- Real alert dispatch (all optional) -----------------------------------------
# Full walkthrough in ALERTS_SETUP.md. Secrets live here / in the host's env
# vars, never in the repo. Either or both channels; a zone crossing into
# High/Critical fires them, and POST /api/alerts/dispatch-test sends a sample.

# Telegram Bot API: create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone SMS. Set SMS_TO (E.164, comma-separated for several) and it works with
# the free shared Textbelt key: 1 SMS/day, no signup.
SMS_TO=
# SMS_PROVIDER=textbelt        # default. others: twilio | fast2sms
# TEXTBELT_KEY=                # your own Textbelt key for unlimited sends
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# FAST2SMS_KEY=

# Generic JSON webhook (Slack / Discord / any endpoint).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Set to 0 to stop the "Run escalation demo" button from sending real alerts.
CODENEXUS_ALERT_ON_SIM=1
