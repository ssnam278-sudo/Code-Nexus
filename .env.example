# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# API server
CORS_ORIGINS=http://localhost:8000

# Optional: require this header on POST /api/ingest/telemetry
INGEST_API_KEY=replace-with-a-long-random-secret

# --- Real alert dispatch (all optional, all free) --------------------------------
# Telegram Bot API: create a bot with @BotFather, then get your chat id.
# Full walkthrough in TELEGRAM_SETUP.md. Held only here / in the host's env vars,
# never in the repo. When both are set, a zone crossing into High/Critical sends
# a real message; POST /api/alerts/dispatch-test sends a sample.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic JSON webhook (Slack / Discord / any endpoint) - alternative to Telegram.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Set to 0 to stop the "Run escalation demo" button from sending real alerts.
CODENEXUS_ALERT_ON_SIM=1
